<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_oh_asset_assignment_list" model="ir.ui.view">

        <field name="name">oh.asset.assignment.list</field>
        <field name="model">oh.asset.assignment</field>

        <field name="arch" type="xml">

            <list>

                <field name="asset_id"/>
                <field name="assigned_to"/>
                <field name="assignment_date"/>
                <field name="return_date"/>
                <field name="location"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <record id="view_oh_asset_assignment_form"
            model="ir.ui.view">

        <field name="name">oh.asset.assignment.form</field>
        <field name="model">oh.asset.assignment</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_return"
                        type="object"
                        string="Return Asset"
                        class="btn-primary"
                        invisible="state == 'returned'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="active,returned"
                    />

                </header>


                <sheet>

                    <group>

                        <field name="asset_id"/>
                        <field name="assigned_to"/>

                    </group>


                    <group>

                        <field name="assignment_date"/>
                        <field name="return_date"/>
                        <field name="location"/>

                    </group>


                    <group>

                        <field name="notes"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="action_oh_asset_assignment"
            model="ir.actions.act_window">

        <field name="name">Assignments</field>
        <field name="res_model">oh.asset.assignment</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>