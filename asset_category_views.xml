<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_oh_asset_category_list" model="ir.ui.view">
        <field name="name">oh.asset.category.list</field>
        <field name="model">oh.asset.category</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="view_oh_asset_category_form" model="ir.ui.view">
        <field name="name">oh.asset.category.form</field>
        <field name="model">oh.asset.category</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="asset_count"/>
                        <field name="active"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_oh_asset_category"
            model="ir.actions.act_window">

        <field name="name">Asset Categories</field>
        <field name="res_model">oh.asset.category</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>