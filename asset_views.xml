<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_oh_asset_list" model="ir.ui.view">

        <field name="name">oh.asset.list</field>
        <field name="model">oh.asset</field>

        <field name="arch" type="xml">

            <list>

                <field name="asset_code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="assigned_to"/>
                <field name="location"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <record id="view_oh_asset_form" model="ir.ui.view">

        <field name="name">oh.asset.form</field>
        <field name="model">oh.asset</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="available,assigned,maintenance,retired"
                    />

                </header>


                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>


                    <group>

                        <group>

                            <field name="asset_code"/>
                            <field name="category_id"/>
                            <field name="serial_number"/>

                        </group>


                        <group>

                            <field name="assigned_to"/>
                            <field name="location"/>
                            <field name="company_id"/>
                            <field name="active"/>

                        </group>

                    </group>


                    <notebook>

                        <page string="Purchase Information">

                            <group>

                                <field name="purchase_date"/>
                                <field name="purchase_price"/>

                            </group>

                        </page>


                        <page string="Description">

                            <field name="description"/>

                        </page>


                        <page string="Notes">

                            <field name="notes"/>

                        </page>

                    </notebook>

                </sheet>


                <div class="oe_chatter">

                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>

                </div>

            </form>

        </field>

    </record>


    <record id="action_oh_asset" model="ir.actions.act_window">

        <field name="name">Assets</field>
        <field name="res_model">oh.asset</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>